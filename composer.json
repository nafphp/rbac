{
    "name": "naf/rbac",
    "description": "Roles, permissions and the rules for handing them out, for NAF hosts.",
    "type": "naf-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "naf/framework": "^0.2.6",
        "naf/auth": "^0.2",
        "naf/database": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "Naf\\Rbac\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --colors=always",
        "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "style:fix": "@php vendor/bin/php-cs-fixer fix"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.25",
        "phpunit/phpunit": "^12.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "naf": {
            "boot": {
                "after": [
                    "naf/cli"
                ]
            }
        }
    }
}
